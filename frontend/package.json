{
  "name": "qaqc-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Livio QA-QC webapp. Vanilla ES modules bundled by Vite: no framework, no JSX — the store-driven panel architecture is unchanged, Vite only bundles it and vendors the former CDN deps (three, gsap, fonts) so the app runs with the network off.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "gsap": "3.12.5",
    "tailwindcss": "^4.3.3",
    "three": "0.160.0",
    "typescript": "^7.0.2",
    "vite": "8.2.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
